{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurora",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "."
  },
  "previews": {},
  // Serve only on the custom domain. The *.workers.dev address and the
  // per-version preview URLs would sit outside the Cloudflare Access policy
  // that protects the frameworktools.ca subdomains.
  "workers_dev": false,
  "preview_urls": false
}
